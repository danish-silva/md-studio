{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "md-studio",
  "version": "0.1.0",
  "identifier": "dev.mdstudio.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "md-studio",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "md-studio",
    "copyright": "Copyright (c) md-studio contributors",
    "category": "Productivity",
    "shortDescription": "A markdown editor with a Word-like formatting surface",
    "longDescription": "md-studio edits markdown visually, with a formatting toolbar, tables, an explorer over several folders, vertical tabs and restorable workspaces. Markdown text is always the source of truth: the toolbar emits no HTML, and files round-trip unchanged.",
    "windows": {
      "wix": {
        "language": [
          "en-US"
        ]
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    }
  }
}
